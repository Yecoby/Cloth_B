# ---------------------------------------------------------------------------
# LaundryOS environment configuration
# Copy to .env for local dev (docker compose reads this automatically)
# NEVER commit the real .env file — it is gitignored.
# ---------------------------------------------------------------------------

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="LaundryOS"

# --- Database (Postgres) ---
DATABASE_URL="postgresql://laundry:laundry_dev_password@postgres:5432/laundry_db?schema=public"

# --- Redis (sessions cache, rate limiting, queues) ---
REDIS_URL="redis://redis:6379"

# --- Auth.js / NextAuth ---
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace_me_with_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"

# Social login (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- JWT / session ---
JWT_SIGNING_KEY="replace_me_with_openssl_rand_base64_32"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- GCash / Maya (PH local payment gateways, via PayMongo or similar aggregator) ---
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# --- Google Maps ---
GOOGLE_MAPS_API_KEY="replace_me"

# --- AWS S3 (image uploads) ---
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET="laundry-os-uploads"

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM="LaundryOS <no-reply@laundryos.app>"

# --- Twilio (SMS + OTP) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Pusher (real-time order tracking) — alternative to self-hosted socket.io ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1

# --- Security ---
# Comma-separated list of allowed CORS origins for the public API
CORS_ALLOWED_ORIGINS="http://localhost:3000"
# Rate limit: requests per window per IP
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION_SECONDS=60

# --- Logging ---
LOG_LEVEL=info
